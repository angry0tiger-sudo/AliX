# AliX safe defaults. Never put real secrets in this file.
ALIx_ENV=paper
ALIx_DRY_RUN=true
ALIx_ALLOW_LIVE_TRADING=false
ALIx_LOG_LEVEL=INFO

# Optional secrets are empty by default and must be injected by an approved secret manager.
NOBITEX_API_KEY=
NOBITEX_API_SECRET=
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# Reporting is disabled until timezone and chat allowlist are explicitly configured.
ALIx_REPORTING_ENABLED=false
ALIx_REPORT_TIMEZONE=Asia/Tehran
ALIx_BALE_CHAT_ALLOWLIST=
