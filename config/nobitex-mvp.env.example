# AliX Nobitex MVP: fail-closed defaults
ALIX_DRY_RUN=true
ALIX_ALLOW_LIVE_TRADING=false

# Paper simulation settings
NOBITEX_SYMBOL=BTCUSDT
MVP_PAPER_EQUITY_QUOTE=1000
MVP_RISK_PER_TRADE=0.005
MVP_MAX_POSITION_FRACTION=0.10
MVP_TIMEFRAME_MINUTES=30

# Not used by the paper MVP. Do not add credentials to source control.
# A Nobitex API Key requires its paired private signing key; the public half
# alone is not an authentication token. Live trading is currently blocked.
NOBITEX_API_KEY=
NOBITEX_API_PRIVATE_KEY=
